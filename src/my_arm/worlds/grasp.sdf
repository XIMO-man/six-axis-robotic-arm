<?xml version="1.0"?>
<sdf version="1.9">
  <world name="grasp_world">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.85 0.88 0.92 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><direction>-0.5 -0.5 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static><link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Solid workbench, top at z=0.30 m. -->
    <model name="table">
      <static>true</static><pose>0.45 0 0.15 0 0 0</pose>
      <link name="table">
        <collision name="collision"><geometry><box><size>0.50 0.50 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.50 0.50 0.30</size></box></geometry>
          <material><diffuse>0.30 0.35 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="grasp_cube">
      <pose>0.35 0 0.321 0 0 0</pose>
      <link name="cube">
        <inertial><mass>0.03</mass><inertia><ixx>0.000008</ixx><iyy>0.000008</iyy><izz>0.000008</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><diffuse>0.1 0.65 0.2 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>30</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
